# MaSoVa Mobile Customer App - Environment Variables
# Copy to .env for local development

# Base URL for API Gateway (Dell host in dev: http://localhost:8080/api)
API_BASE_URL=http://localhost:8080/api

# WebSocket URL for API Gateway
WS_BASE_URL=ws://localhost:8080/api/ws

# Environment mode: development | staging | production
APP_ENV=development

# Enable mock menu fallback (MUST be false in production builds)
ENABLE_MOCK_FALLBACK=false

# Observability DSN (Sentry placeholder)
SENTRY_DSN=
